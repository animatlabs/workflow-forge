<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Version is centralized in src/Directory.Build.props -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <AssemblyName>WorkflowForge.Extensions.Observability.OpenTelemetry</AssemblyName>
    <RootNamespace>WorkflowForge.Extensions.Observability.OpenTelemetry</RootNamespace>
    
    <!-- Package Information -->
    <PackageId>WorkflowForge.Extensions.Observability.OpenTelemetry</PackageId>
    <Title>WorkflowForge OpenTelemetry Extension</Title>
    <Description>OpenTelemetry integration for WorkflowForge providing distributed tracing, metrics collection, and observability instrumentation for comprehensive workflow monitoring and debugging.</Description>
    <Authors>AnimatLabs</Authors>
    <Company>AnimatLabs</Company>
    <Product>WorkflowForge OpenTelemetry Extension</Product>
    <PackageTags>workflowforge;workflow;opentelemetry;tracing;metrics;observability;distributed-tracing;dotnet;csharp</PackageTags>
    <PackageProjectUrl>https://github.com/animatlabs/workflow-forge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/animatlabs/workflow-forge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    
    <!-- NuGet Package Settings -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Documentation (NuGet readme generated; see src/build/Packaging/NuGetReadme.targets) -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes><![CDATA[WorkflowForge.Extensions.Observability.OpenTelemetry 2.2.0

BREAKING
- This package no longer depends on the OpenTelemetry SDK. It referenced no OpenTelemetry type, so the packages are removed along with their 10.0.10 floors and advisory GHSA-g94r-2vxg-569j. It now declares System.Diagnostics.DiagnosticSource 8.0.1 alone and is no longer an ILRepack package. Your application owns the SDK and subscribes with .AddSource(serviceName) / .AddMeter(serviceName).

Added
- EnableOpenTelemetry now registers middleware that creates one span and one set of metrics per operation. CreateOpenTelemetryWorkflowMiddleware() returns the workflow-level middleware that parents those spans. EnableTracing, EnableMetrics, EnableSystemMetrics and EnableOperationMetrics all take effect.
- EnableOpenTelemetry is idempotent; it previously built a second instrument graph and silently stopped instruments already handed out.

Full changelog: https://github.com/animatlabs/workflow-forge/blob/main/CHANGELOG.md#220---2026-09-15]]></PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../core/WorkflowForge/WorkflowForge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
