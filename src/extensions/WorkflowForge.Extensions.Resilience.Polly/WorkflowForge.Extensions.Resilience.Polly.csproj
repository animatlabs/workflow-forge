<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Version is centralized in src/Directory.Build.props -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <AssemblyName>WorkflowForge.Extensions.Resilience.Polly</AssemblyName>
    <RootNamespace>WorkflowForge.Extensions.Resilience.Polly</RootNamespace>
    
    <!-- Package Information -->
    <PackageId>WorkflowForge.Extensions.Resilience.Polly</PackageId>
    <Title>WorkflowForge Polly Resilience Extension</Title>
    <Description>Polly integration for WorkflowForge providing resilience patterns including circuit breakers, retries and timeouts for robust workflow execution.</Description>
    <Authors>AnimatLabs</Authors>
    <Company>AnimatLabs</Company>
    <Product>WorkflowForge Polly Extension</Product>
    <PackageTags>workflowforge;workflow;polly;resilience;circuit-breaker;retry;timeout;dotnet;csharp</PackageTags>
    <PackageProjectUrl>https://github.com/animatlabs/workflow-forge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/animatlabs/workflow-forge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    
    <!-- NuGet Package Settings -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ILRepackTargetsFile>$(MSBuildThisFileDirectory)ILRepack.targets</ILRepackTargetsFile>
    <WorkflowForgeIlRepackVerifyAssemblies>Polly.dll;Polly.Core.dll</WorkflowForgeIlRepackVerifyAssemblies>
    
    <!-- Documentation (NuGet readme generated; see src/build/Packaging/NuGetReadme.targets) -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes><![CDATA[WorkflowForge.Extensions.Resilience.Polly 2.2.0

BREAKING
- Removed PollyMiddlewareOptions.RateLimiter, PollyRateLimiterSettings and PollyTimeoutSettings.UseOptimisticTimeout. Rate limiting was validated and cloned but never built into a pipeline; Polly v8 timeouts are always cooperative.
- Bulkhead isolation and rate limiting have been struck from the package description; neither was implemented.
- AddWorkflowForgePolly(configuration) now defaults to WorkflowForge:Extensions:Polly (PollyMiddlewareOptions.DefaultSectionName) instead of WorkflowForge:Polly, which bound nothing.

Fixed
- The netstandard2.0 asset declares its four BCL dependencies again (Microsoft.Bcl.TimeProvider, Microsoft.Bcl.AsyncInterfaces, System.ComponentModel.Annotations, System.Threading.Tasks.Extensions).
- The pipeline is now composed from whichever of Retry, Timeout and CircuitBreaker is enabled, honouring BackoffType, UseJitter, SamplingDuration and MinimumThroughput. DefaultTags and EnableDetailedLogging are applied.

Full changelog: https://github.com/animatlabs/workflow-forge/blob/main/CHANGELOG.md#220---2026-09-15]]></PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WorkflowForge.Extensions.Resilience/WorkflowForge.Extensions.Resilience.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Polly" PrivateAssets="all" />
    <!--
      Polly is ILRepack-merged (PrivateAssets="all"), so its transitive dependencies are NOT
      written to this package's nuspec. The merged Polly.Core IL still references these BCL
      assemblies at runtime, so they must be declared here as regular (flowing) dependencies
      or consumers hit FileNotFoundException. These are BCL polyfills and must NOT be ILRepacked
      (System.* type-identity conflicts).
    -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="System.ComponentModel.Annotations" />
    <PackageReference Include="System.Threading.Tasks.Extensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../icon.png" Pack="true" PackagePath="\" />
    <None Include="../../build/Packaging/THIRD-PARTY-NOTICES-Polly.txt" Pack="true" PackagePath="THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

</Project>
