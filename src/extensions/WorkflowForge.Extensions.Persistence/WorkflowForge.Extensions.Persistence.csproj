<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>WorkflowForge.Extensions.Persistence</AssemblyName>
    <RootNamespace>WorkflowForge.Extensions.Persistence</RootNamespace>

    <!-- Package Information -->
    <PackageId>WorkflowForge.Extensions.Persistence</PackageId>
    <Title>WorkflowForge Persistence Extension</Title>
    <Description>Persistence extension for WorkflowForge enabling resumable workflows via a pluggable provider (bring your own storage). Zero-dependency core integration.</Description>
    <Authors>AnimatLabs</Authors>
    <Company>AnimatLabs</Company>
    <Product>WorkflowForge Persistence Extension</Product>
    <PackageTags>workflowforge;workflow;persistence;state;checkpoint;resume;dotnet;csharp</PackageTags>
    <PackageProjectUrl>https://github.com/animatlabs/workflow-forge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/animatlabs/workflow-forge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- NuGet Package Settings -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>


    <!-- Documentation (NuGet readme generated; see src/build/Packaging/NuGetReadme.targets) -->
    <PackageIcon>icon.png</PackageIcon>
    <!-- Version is centralized in src/Directory.Build.props -->

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <PackageReleaseNotes><![CDATA[WorkflowForge.Extensions.Persistence 2.2.0

BREAKING
- Removed PersistenceOptions.MaxVersions and the duplicate PersistenceMiddlewareOptions type. IWorkflowPersistenceProvider stores one snapshot per key, so versioning was not implementable, and the duplicate type bound the same configuration section with different defaults.

Fixed
- PersistOnOperationComplete, PersistOnWorkflowComplete and PersistOnFailure now each change when a checkpoint is written. PersistOnFailure in particular wrote nothing before, because the checkpoint ran only after a successful operation.

Full changelog: https://github.com/animatlabs/workflow-forge/blob/main/CHANGELOG.md#220---2026-09-15]]></PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../core/WorkflowForge/WorkflowForge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

