<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Version is centralized in src/Directory.Build.props -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <AssemblyName>WorkflowForge.Extensions.Audit</AssemblyName>
    <RootNamespace>WorkflowForge.Extensions.Audit</RootNamespace>
    
    <!-- Package Information -->
    <PackageId>WorkflowForge.Extensions.Audit</PackageId>
    <Title>WorkflowForge Audit Extension</Title>
    <Description>Comprehensive audit logging extension for WorkflowForge providing detailed tracking of workflow execution, data changes, and compliance reporting.</Description>
    <Authors>AnimatLabs</Authors>
    <Company>AnimatLabs</Company>
    <Product>WorkflowForge Audit Extension</Product>
    <PackageTags>workflowforge;workflow;audit;logging;compliance;tracking;dotnet;csharp</PackageTags>
    <PackageProjectUrl>https://github.com/animatlabs/workflow-forge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/animatlabs/workflow-forge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    
    <!-- NuGet Package Settings -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- Documentation (NuGet readme generated; see src/build/Packaging/NuGetReadme.targets) -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes><![CDATA[WorkflowForge.Extensions.Audit 2.2.0

BREAKING
- InMemoryAuditProvider(int maxEntries) throws ArgumentOutOfRangeException for values below one instead of silently substituting 10,000.

Fixed
- AuditDetailLevel values are now distinct: Minimal omits metadata, duration and initiator; Verbose adds foundry properties; Complete adds input and output payloads. LogDataPayloads now captures payloads at any level above Minimal.
- InMemoryAuditProvider evicts through a queue instead of List.RemoveAt(0), which was an O(n) memmove on every write once at cap.

Full changelog: https://github.com/animatlabs/workflow-forge/blob/main/CHANGELOG.md#220---2026-09-15]]></PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\WorkflowForge\WorkflowForge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
