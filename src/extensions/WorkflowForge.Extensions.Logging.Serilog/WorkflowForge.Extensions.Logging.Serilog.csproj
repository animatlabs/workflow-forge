<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Version is centralized in src/Directory.Build.props -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    
    <!-- Package Information -->
    <PackageId>WorkflowForge.Extensions.Logging.Serilog</PackageId>
    <Title>WorkflowForge Serilog Extension</Title>
    <Description>Serilog adapter for WorkflowForge providing professional structured logging capabilities with rich context and correlation.</Description>
    <Authors>AnimatLabs</Authors>
    <Company>AnimatLabs</Company>
    <Product>WorkflowForge Serilog Extension</Product>
    <PackageTags>workflowforge;workflow;orchestration;logging;serilog;structured-logging;dotnet;csharp</PackageTags>
    <PackageProjectUrl>https://github.com/animatlabs/workflow-forge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/animatlabs/workflow-forge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    
    <!-- NuGet Package Settings -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ILRepackTargetsFile>$(MSBuildThisFileDirectory)ILRepack.targets</ILRepackTargetsFile>
    <WorkflowForgeIlRepackVerifyAssemblies>Serilog.dll;Serilog.Sinks.Console.dll</WorkflowForgeIlRepackVerifyAssemblies>
    
    <!-- Documentation (NuGet readme generated; see src/build/Packaging/NuGetReadme.targets) -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes><![CDATA[WorkflowForge.Extensions.Logging.Serilog 2.2.0

BREAKING
- Removed SerilogLoggerFactory.CreateLogger(ILogger). Its parameter was an internalized Serilog type, so the overload could not be called from outside the assembly. Use CreateLogger(SerilogLoggerOptions) or CreateLogger(ILoggerFactory).

Fixed
- Structured properties and scopes reached no sink: the embedded pipeline never enabled Enrich.FromLogContext(), so everything pushed through LogContext was dropped.
- The logger returned by CreateLogger(SerilogLoggerOptions) now owns and disposes its Serilog pipeline.
- Dropped the unused Serilog.Extensions.Logging reference, removing a 10.0.10 dependency floor.

Full changelog: https://github.com/animatlabs/workflow-forge/blob/main/CHANGELOG.md#220---2026-09-15]]></PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../../icon.png" Pack="true" PackagePath="\" />
    <None Include="../../build/Packaging/THIRD-PARTY-NOTICES-Serilog.txt" Pack="true" PackagePath="THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Serilog" PrivateAssets="all" />
    <PackageReference Include="Serilog.Sinks.Console" PrivateAssets="all" />
    <!--
      Serilog is ILRepack-merged (PrivateAssets="all"), so its transitive dependencies are NOT
      written to this package's nuspec. The merged IL still references these at runtime; declare
      them as regular (flowing) dependencies so consumers don't hit FileNotFoundException.
      Do NOT ILRepack these (System.* type-identity conflicts).
    -->
    <PackageReference Include="System.Threading.Channels" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\WorkflowForge\WorkflowForge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WorkflowForge.Extensions.Logging.Serilog.Tests, " />
  </ItemGroup>

</Project>
