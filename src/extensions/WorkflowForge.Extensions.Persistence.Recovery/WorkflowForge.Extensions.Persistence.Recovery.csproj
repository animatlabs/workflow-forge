<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>WorkflowForge.Extensions.Persistence.Recovery</AssemblyName>
    <RootNamespace>WorkflowForge.Extensions.Persistence.Recovery</RootNamespace>
    <PackageId>WorkflowForge.Extensions.Persistence.Recovery</PackageId>
    <Title>WorkflowForge Persistence Recovery Extension</Title>
    <Description>Recovery orchestration for WorkflowForge persistence: resume workflows from last checkpoints, with configurable retry and hooks.</Description>
    <Authors>AnimatLabs</Authors>
    <Company>AnimatLabs</Company>
    <Product>WorkflowForge Persistence Recovery</Product>
    <PackageTags>workflowforge;workflow;persistence;recovery;resumption;resume;dotnet;csharp</PackageTags>
    <PackageProjectUrl>https://github.com/animatlabs/workflow-forge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/animatlabs/workflow-forge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Version is centralized in src/Directory.Build.props -->
    <PackageReleaseNotes><![CDATA[WorkflowForge.Extensions.Persistence.Recovery 2.2.0

BREAKING
- RecoveryCoordinator now requires a logger: RecoveryCoordinator(provider, logger, options?). ResumeAllAsync continues past snapshots it cannot resume, and the logger is the only record of them.

Fixed
- Documented that the foundryFactory MUST attach PersistenceMiddleware with the same provider. Resume replays from index 0; without that middleware every completed operation re-executes, repeating side effects.

Full changelog: https://github.com/animatlabs/workflow-forge/blob/main/CHANGELOG.md#220---2026-09-15]]></PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WorkflowForge.Extensions.Persistence/WorkflowForge.Extensions.Persistence.csproj" />
    <ProjectReference Include="../../core/WorkflowForge/WorkflowForge.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
