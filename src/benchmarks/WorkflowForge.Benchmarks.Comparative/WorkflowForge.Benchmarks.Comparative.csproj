<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <SonarQubeExclude>true</SonarQubeExclude>
    <IsPackable>false</IsPackable>
    <!-- Elsa/WorkflowCore pull mixed dependency versions; this executable is not shipped as a package. -->
    <NuGetAudit>false</NuGetAudit>

    <!-- Package Information -->
    <AssemblyName>WorkflowForge.Benchmarks.Comparative</AssemblyName>
    <RootNamespace>WorkflowForge.Benchmarks.Comparative</RootNamespace>
    <Description>Comparative performance benchmarks: WorkflowForge vs Workflow Core vs Elsa Workflows</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- BenchmarkDotNet for scientific performance measurement -->
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" />
    <PackageReference Include="Snappier" />
    <!-- Workflow Core - Established workflow engine (latest stable) -->
    <PackageReference Include="WorkflowCore" />
    
  </ItemGroup>

  <!-- Elsa only on net8.0+ (it doesn't support net48) -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="Elsa" />
    <PackageReference Include="Elsa.Workflows.Core" />
    <PackageReference Include="Elsa.Workflows.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference WorkflowForge core project -->
    <ProjectReference Include="..\..\core\WorkflowForge\WorkflowForge.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="All" />
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

</Project>

